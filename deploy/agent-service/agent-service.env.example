# Copy values into a deployment platform or secret manager. Spring Boot does not load this file automatically.
# Keep real credentials out of source control. Defaults start the agent with no model provider.

# Service and infrastructure
SERVER_PORT=9070
SPRING_PROFILES_ACTIVE=
SPRING_CLOUD_NACOS_DISCOVERY_ENABLED=false
SPRING_CLOUD_NACOS_CONFIG_ENABLED=false
SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=127.0.0.1:8848
AGENT_SERVICE_TOKEN=

# Model flags and provider settings
AGENT_MODEL_ENABLED=false
AGENT_TOOL_CALLING_ENABLED=false
AGENT_MODEL_PROVIDER=disabled
AGENT_MODEL_BASE_URL=http://127.0.0.1:8000
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=qwen-plus
AGENT_MODEL_CONNECT_TIMEOUT=3s
AGENT_MODEL_READ_TIMEOUT=60s
AGENT_MODEL_MAX_TOOL_ROUNDS=3
AI_DASHSCOPE_API_KEY=
AGENT_DASHSCOPE_AGENT_ENABLED=false

# Tool execution safety controls
AGENT_TOOL_TIMEOUT=5s
AGENT_TOOL_MAX_RETRIES=1
AGENT_TOOL_FAILURE_THRESHOLD=3
AGENT_TOOL_OPEN_DURATION=30s

# Optional MySQL persistence (requires SPRING_PROFILES_ACTIVE=mysql)
AGENT_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/enjoytix_agent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AGENT_MYSQL_USERNAME=root
AGENT_MYSQL_PASSWORD=
AGENT_MYSQL_MAXIMUM_POOL_SIZE=8

# Optional knowledge-source ingestion and object storage
AGENT_KNOWLEDGE_CHUNK_MAX_CHARACTERS=1200
AGENT_KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=120
AGENT_KNOWLEDGE_SOURCE_MAX_BYTES=20971520
AGENT_KNOWLEDGE_SOURCE_CONNECT_TIMEOUT=3s
AGENT_KNOWLEDGE_SOURCE_READ_TIMEOUT=30s
AGENT_KNOWLEDGE_SOURCE_ALLOWED_CONTENT_TYPES=text/plain,text/markdown,text/html,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
AGENT_KNOWLEDGE_STORAGE_ENABLED=false
AGENT_KNOWLEDGE_STORAGE_ENDPOINT=http://127.0.0.1:9000
AGENT_KNOWLEDGE_STORAGE_REGION=us-east-1
AGENT_KNOWLEDGE_STORAGE_BUCKET=enjoytix-knowledge
AGENT_KNOWLEDGE_STORAGE_ACCESS_KEY=
AGENT_KNOWLEDGE_STORAGE_SECRET_KEY=
AGENT_KNOWLEDGE_STORAGE_PATH_STYLE_ACCESS=true
AGENT_KNOWLEDGE_STORAGE_MAX_BYTES=20971520
